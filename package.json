{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test": "pnpm --filter @workspace/anchor run test && pnpm run test:release-tools",
    "test:release-tools": "node --test artifacts/api-server/tests/clerk-proxy.test.mjs artifacts/mockup-sandbox/tests/mockup-discovery.test.mjs",
    "verify:pwa": "node scripts/verify-built-pwa.mjs",
    "typecheck:libs": "node ./node_modules/typescript/lib/tsc.js --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:browser": "playwright test",
    "typecheck:tests": "pnpm --filter @workspace/anchor run typecheck:tests"
  },
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.9.x"
  }
}
